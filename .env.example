# Supabase PostgreSQL + Clerk configuration for Kanishk HRM Backend.
# Copy to .env (ignored by Git) — Spring Boot loads .env automatically on startup.

SPRING_PROFILES_ACTIVE=prod

# Supabase PostgreSQL JDBC URL
# Direct:         jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Session pooler: jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=your_supabase_db_password
DB_POOL_SIZE=5

# Clerk Authentication (100% Clerk-managed — no local passwords or tokens)
CLERK_ISSUER=https://positive-caiman-7190.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Allowed frontend origins (comma-separated)
HRM_FRONTEND_ORIGIN=https://sampat-barik.github.io,https://kanishkservices.com

# Business rules & server binding
HRM_ZONE=Asia/Kolkata
DAILY_REGULAR_HOURS=8
BIND_ADDRESS=127.0.0.1
PORT=8080
