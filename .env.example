# Production / Supabase PostgreSQL configuration template for Kanishk HRM Backend.
# Copy to .env (ignored by Git) — Spring Boot loads .env automatically on startup.

# Activate production profile for Supabase (disables automatic schema.sql execution on startup)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL / Supabase JDBC URL
# Direct connection: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Session pooler (IPv4): jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/hrm?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=change_me_strong_password
DB_POOL_SIZE=5

# Initial HR Admin account (required on first startup when not using demo profile; min 12 chars)
HRM_ADMIN_EMAIL=admin@kanishkservices.com
HRM_ADMIN_PASSWORD=ChangeMeToAStrongPassword123!

# Hosted frontend origin for cross-origin API calls (omit when reverse-proxied same-origin under /api)
HRM_FRONTEND_ORIGIN=https://kanishkservices.com

# Clerk JWT issuer URL for RS256 JWKS token verification (public URL, not a secret)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Business rules & server binding
HRM_ZONE=Asia/Kolkata
DAILY_REGULAR_HOURS=8
BIND_ADDRESS=127.0.0.1
PORT=8080
