{
  "name": "Kanishk HRM Spring Boot Backend",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bullseye",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Kanishk HRM Web UI & API",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "chmod +x mvnw && ./mvnw test-compile -B",
  "postAttachCommand": "./mvnw spring-boot:run -Dspring-boot.run.profiles=demo -Dspring-boot.run.arguments=--server.address=0.0.0.0"
}
